{
  "name": "majestic-catalog-overlay",
  "version": "1.0.0",
  "description": "Памятка семьи Polix Creator : KATO",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "dev.majestic.catalog.overlay",
    "productName": "Памятка семьи Polix Creator : KATO",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "overlay.css"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "PolixCreatorKATO-${version}.exe"
    }
  },
  "productName": "Памятка семьи Polix Creator : KATO"
}