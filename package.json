{
  "name": "majestic-catalog-overlay",
  "version": "1.0.0",
  "description": "Памятка семьи Polix Creator - KATO",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "dev.majestic.catalog.overlay",
    "productName": "Памятка семьи Polix Creator - KATO",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "overlay.css",
      "tray.png"
    ],
    "publish": {
      "provider": "github",
      "owner": "kartonden123",
      "repo": "Helper-Polix",
      "releaseType": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Памятка семьи Polix Creator - KATO",
      "artifactName": "PolixCreatorKATO-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}