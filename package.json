{
  "name": "majestic-catalog-overlay",
  "version": "2.4.1",
  "description": "Polix Helper by KATO",
  "main": "main.js",
  "author": "KATO",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "dev.majestic.catalog.overlay",
    "productName": "Polix Helper",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "data.js",
      "ak.js",
      "notice.js",
      "split.js",
      "poker.js",
      "chat.js",
      "laws.js",
      "rules.js",
      "extras.js",
      "extras2.js",
      "anim.js",
      "ai.js",
      "staff.js",
      "updater-ui.js",
      "logo.png",
      "auth.js",
      "login.html",
      "tray.png"
    ],
    "publish": {
      "provider": "github",
      "owner": "kartonden123",
      "repo": "Helper-Polix",
      "releaseType": "release"
    },
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Polix Helper",
      "artifactName": "PolixHelper-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "ws": "^8.22.1"
  }
}
